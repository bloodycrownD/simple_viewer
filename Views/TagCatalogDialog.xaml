<UserControl
    x:Class="SimpleViewer.Views.TagCatalogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleViewer.Views"
    MinWidth="460">
    <!-- 职责：标签目录选择器（单图详情右栏「＋」，2026-09-19 交互重构）——两级行列表：
              组行（组名 + 互斥/兼容徽章，不可点）+ 标签行（可点 = 为当前图打该标签）；
              已含该标签的行显示已选态（✓ 已有，禁点防误触移除）。
              对照 TagEditDialog/ShowTagEditorAsync 模板：ContentDialog 宿主、快捷键屏蔽在 MainWindow；
              点击标签行 → 事件 TagApplied（宿主关闭对话框）→ MainViewModel.ApplyCatalogTagAsync
              （单图 toggle 管线"添加"方向；同图改名链路保证右栏 chips 不闪不重载地刷新）。 -->

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明文本（13px 次要色，对齐 TagEditDialog .modal-msg 惯例） -->
        <TextBlock
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            LineHeight="22"
            Text="点击标签为当前图片打标（互斥组会替换组内旧标签）；已含标签的行不可点，移除请用右栏 chip 的 ✕。"
            TextWrapping="Wrap" />

        <!-- 目录列表：组行 + 缩进标签行（MaxHeight 限高内滚动） -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TagCatalogGroup">
                        <StackPanel Margin="0,0,0,8" Spacing="2">
                            <!-- 组行：组名 + 徽章 + 计数（不可点——目录选择器只做标签粒度操作） -->
                            <StackPanel
                                Margin="0,4"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}" />
                                <Border
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind views:TagSidebarConverters.ExclusiveBadgeBackground(Exclusive)}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="{x:Bind views:TagSidebarConverters.MultiBadgeStroke(Exclusive)}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{x:Bind views:TagSidebarConverters.ExclusiveBadgeForeground(Exclusive)}"
                                        Text="{x:Bind views:TagSidebarConverters.ExclusiveBadge(Exclusive)}" />
                                </Border>
                            </StackPanel>
                            <!-- 标签行：可点（Click 事件经 Tag 槽位回查条目）；已含 = 已选态禁点 -->
                            <ItemsControl ItemsSource="{x:Bind Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:TagCatalogEntry">
                                        <Button
                                            Click="OnCatalogTagClicked"
                                            IsEnabled="{x:Bind views:TagCatalogDialog.Not(IsApplied)}"
                                            Style="{StaticResource TagTreeRowButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="14">
                                                    <Border
                                                        Width="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch"
                                                        Background="{x:Bind views:TagSidebarConverters.TreeLineBrush()}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{x:Bind views:TagSidebarConverters.TagRowNameForeground(IsApplied)}"
                                                    Text="{x:Bind TagName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind views:TagSidebarConverters.AppliedSuffix(IsApplied)}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
