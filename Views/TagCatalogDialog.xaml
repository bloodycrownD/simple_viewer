<UserControl
    x:Class="SimpleViewer.Views.TagCatalogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleViewer.Views"
    MinWidth="460">
    <!-- 职责：标签目录选择器（单图详情右栏「＋」，2026-09-19 交互重构）——两级行列表：
              组行（对齐侧栏组头视觉：静态展开 chevron + 组名 + 互斥/兼容徽章 + 右对齐计数，
              不可点）+ 标签行（可点 = 为当前图打该标签，样式复用 TagTreeRowButtonStyle：
              缩进连接线 + 互斥组单选圆点 + 右对齐计数）；已含该标签的行显示已选态
              （✓ 已有 + 禁点防误触移除）。计数与侧栏同源（GetTagCatalogSnapshot 快照）；
              宿主 ContentDialog 经 MainWindow.ApplyDialogTheme 跟随应用主题。
              点击标签行 → 事件 TagApplied（宿主关闭对话框）→ MainViewModel.ApplyCatalogTagAsync
              （单图 toggle 管线"添加"方向；同图改名链路保证右栏 chips 不闪不重载地刷新）。 -->

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明文本（13px 次要色，对齐 TagEditDialog .modal-msg 惯例） -->
        <TextBlock
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            LineHeight="22"
            Text="点击标签为当前图片打标（互斥组会替换组内旧标签）；已含标签的行不可点，移除请用右栏 chip 的 ✕。"
            TextWrapping="Wrap" />

        <!-- 目录列表：组行 + 缩进标签行（MaxHeight 限高内滚动）；
             右 Padding 14 让出覆盖式滚动条宽度——计数右对齐到滚动条左侧，不再被遮挡 -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0,0,14,0"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TagCatalogGroup">
                        <StackPanel Margin="0,0,0,6" Spacing="2">
                            <!-- 组行：对齐侧栏组头视觉（chevron 恒为展开态——目录内组固定展开，状态真实；
                                 不可点：目录选择器只做标签粒度操作） -->
                            <Grid MinHeight="36" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="▾" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind views:TagSidebarConverters.ExclusiveBadgeBackground(Exclusive)}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="{x:Bind views:TagSidebarConverters.MultiBadgeStroke(Exclusive)}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{x:Bind views:TagSidebarConverters.ExclusiveBadgeForeground(Exclusive)}"
                                        Text="{x:Bind views:TagSidebarConverters.ExclusiveBadge(Exclusive)}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{x:Bind views:TagSidebarConverters.TreeCountForeground()}"
                                    Text="{x:Bind views:TagSidebarConverters.GroupCountText(TotalCount)}" />
                            </Grid>
                            <!-- 标签行：可点（Click 事件经 Tag 槽位回查条目）；已含 = 已选态禁点；
                                 样式对齐侧栏树行：缩进连接线 + 互斥组单选圆点 + 右对齐计数 -->
                            <ItemsControl ItemsSource="{x:Bind Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:TagCatalogEntry">
                                        <Button
                                            Click="OnCatalogTagClicked"
                                            IsEnabled="{x:Bind views:TagCatalogDialog.Not(IsApplied)}"
                                            Style="{StaticResource TagTreeRowButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 一级缩进 + 竖向连接线（对齐侧栏树行） -->
                                                <Border Width="14">
                                                    <Border
                                                        Width="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch"
                                                        Background="{x:Bind views:TagSidebarConverters.TreeLineBrush()}" />
                                                </Border>
                                                <!-- 行首语义标记（radio/checkbox 隐喻，2026-09-19 统一）：
                                                     互斥组 = 单选圆点、兼容组 = 多选方框（7×7 圆角方），
                                                     均为组色相描边、已含实心；同行两者互斥显示，列宽对齐 -->
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind views:TagSidebarConverters.RadioDotFill(IsApplied)}"
                                                    Stroke="{x:Bind views:TagSidebarConverters.RadioDotStroke(Hue, IsApplied)}"
                                                    StrokeThickness="1.5"
                                                    Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(Group.Exclusive)}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind views:TagSidebarConverters.RadioDotFill(IsApplied)}"
                                                    BorderBrush="{x:Bind views:TagSidebarConverters.RadioDotStroke(Hue, IsApplied)}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2"
                                                    Visibility="{x:Bind views:TagSidebarConverters.NotBoolToVisibility(Group.Exclusive)}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{x:Bind views:TagSidebarConverters.TagRowNameForeground(IsApplied)}"
                                                    Text="{x:Bind TagName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind views:TagSidebarConverters.AppliedSuffix(IsApplied)}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{x:Bind views:TagSidebarConverters.TreeCountForeground()}"
                                                    Text="{x:Bind views:TagSidebarConverters.CountText(Count)}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
