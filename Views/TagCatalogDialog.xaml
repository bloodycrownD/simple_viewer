<UserControl
    x:Class="SimpleViewer.Views.TagCatalogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleViewer.Views"
    MinWidth="460">
    <!-- 职责：标签目录选择器（单图详情右栏「＋」，2026-09-19 交互重构；batch-tag-management Step 5
              批量三态变体 D7）——两级行列表：组行（对齐侧栏组头视觉：静态展开 chevron + 组名 +
              互斥/兼容徽章 + 右对齐计数，不可点）+ 标签行（可点 = 为目标集打该标签，样式复用
              TagTreeRowButtonStyle：缩进连接线 + 互斥组单选圆点 + 右对齐计数）；已选态三态（D7）：
              全部已有 = 禁点（后缀「✓ 已有」单图 /「✓ 全部已有」批量）、部分已有（仅批量）= 可点
              （后缀「部分已有 N/M」）、无 = 可点。计数与侧栏同源（GetTagCatalogSnapshot 快照）；
              宿主 ContentDialog 经 MainWindow.ApplyDialogTheme 跟随应用主题。
              点击标签行 → 事件 TagApplied（宿主关闭对话框）→ MainViewModel.ApplyCatalogTagAsync
              （单图 toggle 管线"添加"方向；同图改名链路保证右栏 chips 不闪不重载地刷新）
              / ApplyCatalogTagToSelectionAsync（批量口径：选中集路径集统一批量打标管线）。 -->

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 说明文本（13px 次要色，对齐 TagEditDialog .modal-msg 惯例；单图/批量构造各自定稿——
             单图文案 = 2026-09-19 原文逐字迁移） -->
        <TextBlock
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            LineHeight="22"
            Text="{x:Bind DescriptionText}"
            TextWrapping="Wrap" />

        <!-- 目录列表：组行 + 缩进标签行（MaxHeight 限高内滚动）；
             右 Padding 14 让出覆盖式滚动条宽度——计数右对齐到滚动条左侧，不再被遮挡 -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="420"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0,0,14,0"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TagCatalogGroup">
                        <StackPanel Margin="0,0,0,6" Spacing="2">
                            <!-- 组行：对齐侧栏组头视觉（chevron 恒为展开态——目录内组固定展开，状态真实；
                                 不可点：目录选择器只做标签粒度操作） -->
                            <Grid MinHeight="36" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="▾" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind views:TagSidebarConverters.ExclusiveBadgeBackground(Exclusive)}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="{x:Bind views:TagSidebarConverters.MultiBadgeStroke(Exclusive)}"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{x:Bind views:TagSidebarConverters.ExclusiveBadgeForeground(Exclusive)}"
                                        Text="{x:Bind views:TagSidebarConverters.ExclusiveBadge(Exclusive)}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{x:Bind views:TagSidebarConverters.TreeCountForeground()}"
                                    Text="{x:Bind views:TagSidebarConverters.GroupCountText(TotalCount)}" />
                            </Grid>
                            <!-- 标签行：可点（Click 事件经 Tag 槽位回查条目）；全部已有 = 已选态禁点（D7 三态，
                                 部分已有仅批量口径出现、可点补齐）；样式对齐侧栏树行：缩进连接线 +
                                 互斥组单选圆点 + 右对齐计数。三态视觉函数 Catalog* 族（TagSidebarConverters）：
                                 bool 旧签名版被侧栏复用不可改，三态版内部委托 bool 版保证色值零漂移 -->
                            <ItemsControl ItemsSource="{x:Bind Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="views:TagCatalogEntry">
                                        <Button
                                            Click="OnCatalogTagClicked"
                                            IsEnabled="{x:Bind views:TagCatalogDialog.Not(ApplyState)}"
                                            Style="{StaticResource TagTreeRowButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 一级缩进 + 竖向连接线（对齐侧栏树行） -->
                                                <Border Width="14">
                                                    <Border
                                                        Width="1"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch"
                                                        Background="{x:Bind views:TagSidebarConverters.TreeLineBrush()}" />
                                                </Border>
                                                <!-- 行首语义标记（radio/checkbox 隐喻，2026-09-19 统一）：
                                                     互斥组 = 单选圆点、兼容组 = 多选方框（7×7 圆角方），
                                                     均为组色相描边、全部已有实心；同行两者互斥显示，列宽对齐 -->
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind views:TagSidebarConverters.CatalogDotFill(ApplyState)}"
                                                    Stroke="{x:Bind views:TagSidebarConverters.CatalogDotStroke(Hue, ApplyState)}"
                                                    StrokeThickness="1.5"
                                                    Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(Group.Exclusive)}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind views:TagSidebarConverters.CatalogDotFill(ApplyState)}"
                                                    BorderBrush="{x:Bind views:TagSidebarConverters.CatalogDotStroke(Hue, ApplyState)}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2"
                                                    Visibility="{x:Bind views:TagSidebarConverters.NotBoolToVisibility(Group.Exclusive)}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{x:Bind views:TagSidebarConverters.CatalogRowNameForeground(ApplyState)}"
                                                    Text="{x:Bind TagName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind views:TagSidebarConverters.CatalogAppliedSuffix(IsBatch, ApplyState, AppliedCount, SelectionCount)}" />
                                                <TextBlock
                                                    Grid.Column="4"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{x:Bind views:TagSidebarConverters.TreeCountForeground()}"
                                                    Text="{x:Bind views:TagSidebarConverters.CountText(Count)}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
