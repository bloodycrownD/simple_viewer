<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleViewer.Views.TagSidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：左侧标签栏（spec Step 9）——目录树形结构：组头整行按钮点击展开/折叠组内标签行
              （chevron ▸折叠/▾展开，BMP 文本字符 U+25B8/U+25BE；展开状态会话内记忆，见 TagSidebarViewModel）；
              按组展示标签行（互斥组单选圆点、每标签实时计数、点击 = 切换筛选，chip 高亮为筛选最小可见反馈）、
              组管理按钮（＋标签 / ⇄ 互斥切换 / ✎ 重命名 / ✕ 删除，嵌于组头按钮内——WinUI 嵌套 Button
              点击各自直达不冒泡，点管理按钮不触发展开切换）、固定末位「未分组」虚拟组（隐藏管理按钮、同享展开折叠）、
              底部「新建标签组」。
              视觉对齐 demo：chip 为组 hue 胶囊（10% 淡底/55% 边框/激活实心 85% 白字，hover 叠加加深）、
              组内标签流式换行（WrapPanel）、组头互斥徽章琥珀色系、管理按钮 ghost 风格。
              按钮字符使用 BMP 常用符号（U+FF0B/U+21C4/U+270E/U+2715），规避 XamlCompiler 沉默崩溃码点
              （PUA 字形与 U+00AB/BB 禁用；图标一律不用 FontIcon/SymbolIcon Glyph）。
              交互不变量：chip 主点击经 OnChipClicked 分流（Click 直达事件不冒泡，内嵌 ✎✕ 按钮不误触）；
              未分组 ✎✕ 入口、Esc 三态等已验证行为保持。 -->

    <Grid Margin="10,12,10,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行（demo .sidebar-head：标签库 + 小型 ghost 按钮） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="标签库" />
            <Button
                Grid.Column="1"
                Command="{x:Bind Main.ToggleSidebarCommand}"
                Content="收起"
                Style="{StaticResource GhostButtonStyle}"
                ToolTipService.ToolTip="收起标签栏" />
        </Grid>

        <!-- 组列表（配置组 + 未分组虚拟组末位） -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagGroupViewModel">
                        <StackPanel Spacing="4">
                            <!-- 组头（目录树态）：整行 Button 承担展开/折叠（Tag 槽位回查组 VM，Click 直达）；
                                 chevron（▸折叠/▾展开）前置，组名/互斥徽章/计数/管理按钮保持原布局；
                                 管理按钮（未分组隐藏）为嵌套独立 Button——点击不冒泡，不触发展开切换 -->
                            <Button
                                Click="OnGroupHeaderClicked"
                                Style="{StaticResource GroupHeaderButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="展开/折叠组内标签">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind views:TagSidebarConverters.ChevronGlyph(IsExpanded)}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Border
                                        Grid.Column="2"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind views:TagSidebarConverters.ExclusiveBadgeBackground(Exclusive)}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="{x:Bind views:TagSidebarConverters.MultiBadgeStroke(Exclusive)}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{x:Bind views:TagSidebarConverters.ExclusiveBadgeForeground(Exclusive)}"
                                            Text="{x:Bind views:TagSidebarConverters.ExclusiveBadge(Exclusive)}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind views:TagSidebarConverters.GroupCountText(TotalCount)}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="4"
                                        Command="{x:Bind Commands.AddTag}"
                                        Content="＋"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        ToolTipService.ToolTip="新建标签"
                                        Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                    <Button
                                        Grid.Column="5"
                                        Command="{x:Bind Commands.ToggleExclusive}"
                                        Content="⇄"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        ToolTipService.ToolTip="切换互斥/兼容"
                                        Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                    <Button
                                        Grid.Column="6"
                                        Command="{x:Bind Commands.RenameGroup}"
                                        Content="✎"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        ToolTipService.ToolTip="重命名组"
                                        Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                    <Button
                                        Grid.Column="7"
                                        Command="{x:Bind Commands.DeleteGroup}"
                                        Content="✕"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        ToolTipService.ToolTip="删除组"
                                        Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                </Grid>
                            </Button>

                            <!-- 标签胶囊行（demo .group-tags：flex-wrap 流式换行；折叠时整行收起）：
                                 胶囊 = 组 hue 边框 + 10% 淡底；激活 = 实心 85% 白字；
                                 内嵌 ✎✕ 为独立 Button（Click 直达事件不冒泡，不打断主点击分流） -->
                            <ItemsControl
                                ItemsSource="{x:Bind Tags}"
                                Visibility="{x:Bind views:TagSidebarConverters.IsExpandedToVisibility(IsExpanded)}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:WrapPanel ItemSpacing="6" LineSpacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagChipViewModel">
                                        <Button
                                            Background="{x:Bind views:TagSidebarConverters.ChipBackground(Hue, IsFilterActive)}"
                                            BorderBrush="{x:Bind views:TagSidebarConverters.ChipBorderBrush(Hue, IsFilterActive)}"
                                            Click="OnChipClicked"
                                            Foreground="{x:Bind views:TagSidebarConverters.ChipForeground(IsFilterActive)}"
                                            Style="{StaticResource ChipCoreButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="点击：打标或筛选 · Shift+点击：从选中集移除标签">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <!-- 互斥组单选圆点（hue 描边；激活白实心） -->
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind views:TagSidebarConverters.RadioDotFill(IsFilterActive)}"
                                                    Stroke="{x:Bind views:TagSidebarConverters.RadioDotStroke(Hue, IsFilterActive)}"
                                                    StrokeThickness="1.5"
                                                    Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(ShowRadioDot)}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{x:Bind views:TagSidebarConverters.ChipCountForeground(IsFilterActive)}"
                                                    Text="{x:Bind views:TagSidebarConverters.CountText(Count)}" />
                                                <Button
                                                    Command="{x:Bind Commands.Rename}"
                                                    Content="✎"
                                                    FontSize="11"
                                                    Foreground="{x:Bind views:TagSidebarConverters.ChipCountForeground(IsFilterActive)}"
                                                    Padding="2,0"
                                                    Style="{StaticResource GhostIconButtonStyle}"
                                                    ToolTipService.ToolTip="重命名标签"
                                                    Visibility="{x:Bind views:TagSidebarConverters.CommandToVisibility(Commands.Rename)}" />
                                                <Button
                                                    Command="{x:Bind Commands.Delete}"
                                                    Content="✕"
                                                    FontSize="11"
                                                    Foreground="{x:Bind views:TagSidebarConverters.ChipCountForeground(IsFilterActive)}"
                                                    Padding="2,0"
                                                    Style="{StaticResource GhostIconButtonStyle}"
                                                    ToolTipService.ToolTip="删除标签"
                                                    Visibility="{x:Bind views:TagSidebarConverters.CommandToVisibility(Commands.Delete)}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 新建标签组（固定入口；ghost 描边风格） -->
        <Button
            Grid.Row="2"
            Command="{x:Bind ViewModel.AddGroupCommand}"
            Content="＋ 新建标签组"
            HorizontalAlignment="Stretch"
            Style="{StaticResource GhostButtonStyle}" />

        <!-- 空态引导 -->
        <TextBlock
            Grid.Row="1"
            Margin="0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="暂无标签组——点击下方「新建标签组」开始"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />
    </Grid>
</UserControl>
