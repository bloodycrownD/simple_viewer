<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleViewer.Views.TagSidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：左侧标签栏（spec Step 9）——按组展示标签行（互斥组单选圆点、每标签实时计数、
              点击 = 切换筛选，chip 高亮为筛选最小可见反馈）、组管理按钮（＋标签 / ⇄ 互斥切换 / ✎ 重命名 / ✕ 删除）、
              固定末位「未分组」虚拟组（隐藏管理按钮，只读聚合）、底部「新建标签组」。
              按钮字符使用 BMP 常用符号（U+FF0B/U+21C4/U+270E/U+2715），规避 XamlCompiler 沉默崩溃码点
              （PUA 字形与 U+00AB/BB 禁用；图标一律不用 FontIcon/SymbolIcon Glyph）。 -->

    <Grid Margin="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="标签" />
            <Button
                Grid.Column="1"
                Command="{x:Bind Main.ToggleSidebarCommand}"
                Content="收起"
                FontSize="12"
                ToolTipService.ToolTip="收起标签栏" />
        </Grid>

        <!-- 组列表（配置组 + 未分组虚拟组末位） -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagGroupViewModel">
                        <StackPanel Spacing="4">
                            <!-- 组头：组名 + 互斥/多选徽章 + 计数 + 管理按钮（未分组隐藏） -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Grid.Column="1"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind views:TagSidebarConverters.ExclusiveBadge(Exclusive)}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind views:TagSidebarConverters.GroupCountText(TotalCount)}"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    Grid.Column="3"
                                    Command="{x:Bind Commands.AddTag}"
                                    Content="＋"
                                    FontSize="12"
                                    Padding="5,2"
                                    ToolTipService.ToolTip="新建标签"
                                    Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                <Button
                                    Grid.Column="4"
                                    Command="{x:Bind Commands.ToggleExclusive}"
                                    Content="⇄"
                                    FontSize="12"
                                    Padding="5,2"
                                    ToolTipService.ToolTip="切换互斥/多选"
                                    Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                <Button
                                    Grid.Column="5"
                                    Command="{x:Bind Commands.RenameGroup}"
                                    Content="✎"
                                    FontSize="12"
                                    Padding="5,2"
                                    ToolTipService.ToolTip="重命名组"
                                    Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                                <Button
                                    Grid.Column="6"
                                    Command="{x:Bind Commands.DeleteGroup}"
                                    Content="✕"
                                    FontSize="12"
                                    Padding="5,2"
                                    ToolTipService.ToolTip="删除组"
                                    Visibility="{x:Bind views:TagSidebarConverters.NotUngroupedToVisibility(IsUngrouped)}" />
                            </Grid>

                            <!-- 标签行列表：点击整行 = 切换筛选 -->
                            <ItemsRepeater ItemsSource="{x:Bind Tags}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagChipViewModel">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 互斥组单选圆点 -->
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind views:TagSidebarConverters.RadioDotBrush(ShowRadioDot), Mode=OneWay}"
                                                Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(ShowRadioDot)}" />

                                            <!-- chip 主体（点击分流 Step 10：选中集非空 = 批量打标 / Shift = 移除；
                                                 单图模式 = 当前图打标；其余 = 切换筛选。Tag 槽位携带 chip VM 供 code-behind 回查） -->
                                            <Button
                                                Grid.Column="1"
                                                Tag="{x:Bind}"
                                                Click="OnChipClicked"
                                                Content="{x:Bind Name}"
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="8,4"
                                                Background="{x:Bind views:TagSidebarConverters.ChipBackground(IsFilterActive), Mode=OneWay}"
                                                ToolTipService.ToolTip="点击：打标或筛选 · Shift+点击：从选中集移除标签" />

                                            <TextBlock
                                                Grid.Column="2"
                                                MinWidth="28"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind views:TagSidebarConverters.CountText(Count)}"
                                                TextAlignment="Right" />
                                            <Button
                                                Grid.Column="3"
                                                Command="{x:Bind Commands.Rename}"
                                                Content="✎"
                                                FontSize="11"
                                                Padding="4,1"
                                                ToolTipService.ToolTip="重命名标签"
                                                Visibility="{x:Bind views:TagSidebarConverters.CommandToVisibility(Commands.Rename)}" />
                                            <Button
                                                Grid.Column="4"
                                                Command="{x:Bind Commands.Delete}"
                                                Content="✕"
                                                FontSize="11"
                                                Padding="4,1"
                                                ToolTipService.ToolTip="删除标签"
                                                Visibility="{x:Bind views:TagSidebarConverters.CommandToVisibility(Commands.Delete)}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 新建标签组（固定入口） -->
        <Button
            Grid.Row="2"
            Command="{x:Bind ViewModel.AddGroupCommand}"
            Content="＋ 新建标签组"
            FontSize="12"
            HorizontalAlignment="Stretch" />

        <!-- 空态引导 -->
        <TextBlock
            Grid.Row="1"
            Margin="0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="暂无标签组——点击下方「新建标签组」开始"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind views:TagSidebarConverters.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />
    </Grid>
</UserControl>
