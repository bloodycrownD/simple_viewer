<UserControl
    x:Class="SimpleViewer.Views.SingleImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：单图查看视图（自 MainWindow Row1 抽出，D14）——图片显示/旋转、空态提示、
              单图详情右栏（2026-09-19 交互重构：图片信息结构化行 + 当前图标签 chips 管理；
              文件名也由右栏信息区承载——底部文件名栏 2026-09-19 用户拍板移除）、
              顶部信息横条（走查 5/6：序号/显示名 + 返回图库按钮，Esc 同效）。
              布局（2026-09-19 遮盖式重排）：根 Grid 单 cell 叠加——ImageHost 画布铺满整根（ZIndex=0，
              几何恒定=整窗，收展侧栏/右栏不再改变显示区、不触发重解码）；右栏（280 展开/36 折叠）与
              返回按钮为 chrome 浮层（ZIndex=1，右/左上对齐，不透明背景遮盖画布）；放大保持画布层
              置底、溢出被 chrome/浮层遮盖属预期（2026-09-19 用户拍板置底）。
              2026-09-25 适配盒改「可见区」（detail-view-fit-visible-area）：画布仍是整窗恒定，
              但 ViewerImage 改 Stretch 对齐 + code-behind 设 Margin（左=左栏宽 / 上=顶部横条底边 /
              右=右栏宽）——元素盒 = 未被 chrome 遮挡的可见区，Uniform 仍按比例 contain 进该盒，
              图片整体可见、不再被左栏/右栏/顶部横条切掉（画布几何与解码链不变）。
              绑定惯例：命令 OneTime、状态 OneWay（对齐 MainWindow 既有 x:Bind 惯例）。
              约束：不用 DockPanel；✕/＋/◀ 为 BMP 文本字符（不用 FontIcon/SymbolIcon Glyph）。 -->

    <Grid>
        <!-- 画布（铺满整根）：ImageHost 即解码尺寸源（SizeChanged → VM.OnViewportSizeChangedAsync），
             仅窗口 resize 触发——侧栏/右栏收展是 chrome 遮盖层显隐，画布几何不变（图片位置不动）。
             Background=ChromeBackgroundBrush（2026-09-24 悬空修复）：画布空白区（图片比例不匹配
             画布时的 letterbox）透出的 RootGrid 暗底与顶部横条 chrome 底色形成断层，返回按钮
             「悬空」——填同底色后横条与画布视觉连续（走查 3 全 chrome 不透明统一的补全面）。 -->
        <Grid
            x:Name="ImageHost"
            Canvas.ZIndex="0"
            Background="{ThemeResource ChromeBackgroundBrush}"
            Padding="8"
            PointerMoved="OnImagePointerMoved"
            PointerPressed="OnImagePointerPressed"
            PointerReleased="OnImagePointerReleased"
            PointerWheelChanged="OnImagePointerWheelChanged">
            <Image
                x:Name="ViewerImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                DoubleTapped="OnImageDoubleTapped"
                RenderTransformOrigin="0.5,0.5"
                Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                Stretch="Uniform"
                Visibility="{x:Bind ViewModel.ImageVisibility, Mode=OneWay}">
                <!-- 对齐 = Stretch（2026-09-25 适配盒改可见区）：元素盒撑满「宿主 - Padding - Margin」
                     （宿主 Padding="8"，见上方 ImageHost），Margin 由 ApplyChromeInsets 设
                     （左=左栏宽 / 上=顶部横条底边 / 右=右栏宽），即未被 chrome 遮挡的可见区；
                     Stretch=Uniform 再把位图按比例 contain 进该盒（WinUI Image 在位图小于盒时居中放置，
                     故位图中心 == 元素盒中心 == 变换原点 0.5,0.5）。
                     原 Center 对齐下元素盒 = 位图盒（Image 期望尺寸 = contain 盒），图片按整窗适配
                     后被 chrome 遮掉约四成宽度——本次基准盒换为可见区即根治。 -->
                <Image.RenderTransform>
                    <!-- CompositeTransform：旋转（VM 绑定）+ 缩放/平移（code-behind 滚轮缩放）；
                         应用顺序 Scale→Rotate→Translate，平移在最外层故拖拽按屏幕 delta 累加即可。 -->
                    <CompositeTransform x:Name="ViewerTransform" Rotation="{x:Bind ViewModel.RotationAngle, Mode=OneWay}" />
                </Image.RenderTransform>
            </Image>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="打开一张图片开始"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />
        </Grid>

        <!-- 顶部信息横条（走查 5 参考图库状态行 + 走查 6 修订）：不透明 chrome 底接管工具栏与画布
             的整个过渡带。**整宽铺设**（Margin 由 ApplyChromeInsets 设：左 0 + 上叠 2dip）——左段
             钻入左栏下方（左栏在 ChromeLayer 层级更高盖住它），与左栏/工具栏的交界从「相邻」变
            「叠加」，DPI 取整不再留透光缝（走查 6：左缘 1px 透出打回）；上叠 2dip 同理（150% DPI
             下 1dip=1.5px，1dip 不满整像素行）。内容（StripContent 左让左栏宽，code-behind 设置）：
            [◀ 返回图库]（走查 6 收进横条首元素——原左上浮层按钮与横条文本重叠不可读；CanExecute=
             HasGallery，CLI 直开无图库时禁用灰态）+ 序号 i/N + 显示名。 -->
        <Border
            x:Name="TopStatusStrip"
            Canvas.ZIndex="1"
            VerticalAlignment="Top"
            Padding="0,5"
            Background="{ThemeResource ChromeBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{x:Bind ViewModel.ImageVisibility, Mode=OneWay}">
            <Grid
                x:Name="StripContent"
                VerticalAlignment="Center"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Command="{x:Bind ViewModel.BackToGalleryCommand}"
                    Content="◀ 返回图库"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="返回图库（Esc）" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CurrentImageIndexText, Mode=OneWay}" />
                <TextBlock
                    x:Name="TopStripFileNameText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 右栏展开态（280，右缘浮层遮盖画布；标题行 + 信息区 + 标签管理）。
             顶部 Margin 由 code-behind 按 VM.TopChromeHeight 避让（chrome 层工具栏横跨整行，
             浮层可点区必须让出这段高度；底部状态栏已移除，底部恒 0）。 -->
        <Border
            x:Name="InfoPanelOverlay"
            Canvas.ZIndex="1"
            Width="280"
            HorizontalAlignment="Right"
            Background="{ThemeResource ChromeBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind ViewModel.InfoPanelExpandedVisibility, Mode=OneWay}">
            <Grid Margin="14,12,14,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题行：图片信息 + 收起（对照左栏「标签库 + 收起」先例） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="图片信息" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.ToggleInfoPanelCommand}"
                        Content="▶"
                        FontSize="13"
                        Style="{StaticResource GhostIconButtonStyle}"
                        ToolTipService.ToolTip="收起信息栏（向右收拢）" />
                </Grid>

                <!-- 信息区：文件名（显示名 = 剥离标签段，文本由 code-behind 组装）+ 结构化行 -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock
                        x:Name="InfoFileNameText"
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.FileNameVisibility, Mode=OneWay}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="文件大小" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Text="{x:Bind ViewModel.CurrentImageFileSizeText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="像素尺寸" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Text="{x:Bind ViewModel.CurrentImageDimensionsText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="序号" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            Text="{x:Bind ViewModel.CurrentImageIndexText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <!-- 标签区：标题「标签」+ ＋ 打开目录选择器；chips 流（✕ 移除）+ 空态文案。
                     2026-09-19 用户走查：chips 不再弹性撑满剩余高度（标签少时的大段空白
                     被误读为"这地方缺内容"）——改内容自适应 + MaxHeight 380 限高滚动
                     （标签很多的图在限高内滚动），空白自然落在面板底部。 -->
                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="标签" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.OpenTagCatalogCommand}"
                            Content="＋"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTipService.ToolTip="添加标签（打开标签目录）" />
                    </Grid>
                    <!-- 限高滚动：内容自适应高度，超过 380 后内部滚动（不占满剩余面板） -->
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="380"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        ZoomMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentImageTags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <views:WrapPanel ItemSpacing="6" LineSpacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <!-- 当前图标签 chip：胶囊 + ✕ 移除（Click 事件经 Tag 槽位回查标签名；
                                         颜色用安全清单 ThemeResource，随 RootGrid 主题正确解析） -->
                                    <Border
                                        Padding="9,3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind}" />
                                            <Button
                                                Click="OnRemoveTagClicked"
                                                Content="✕"
                                                FontSize="11"
                                                Padding="3,0"
                                                Style="{StaticResource GhostIconButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="移除该标签" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="无标签——点击右上「＋」从标签目录添加"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:TagSidebarConverters.NotBoolToVisibility(ViewModel.HasCurrentImageTags), Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 右栏折叠态（36 窄条，右缘浮层，仅展开按钮 ◀ 指向展开方向；对照左栏折叠条先例；
             顶部避让同展开态——折叠条 ◀ 按钮曾因顶到窗口顶被工具栏遮盖点不到） -->
        <Border
            x:Name="InfoPanelCollapsedBar"
            Canvas.ZIndex="1"
            Width="36"
            HorizontalAlignment="Right"
            Background="{ThemeResource ChromeBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Visibility="{x:Bind ViewModel.InfoPanelCollapsedVisibility, Mode=OneWay}">
            <Button
                Margin="0,8,0,0"
                Padding="6,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.ToggleInfoPanelCommand}"
                Content="◀"
                FontSize="13"
                Style="{StaticResource GhostIconButtonStyle}"
                ToolTipService.ToolTip="展开信息栏" />
        </Border>
    </Grid>
</UserControl>
