<UserControl
    x:Class="SimpleViewer.Views.SingleImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 职责：单图查看视图（自 MainWindow Row1 抽出，D14）——图片显示/旋转、空态提示、
              完整文件名一行（等宽字体，方括号标签段高亮；Inlines 由 code-behind 依据 VM 三段属性组装）。
              绑定惯例：命令 OneTime、状态 OneWay（对齐 MainWindow 既有 x:Bind 惯例）。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8">
            <Image
                x:Name="ViewerImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                Stretch="Uniform"
                Visibility="{x:Bind ViewModel.ImageVisibility, Mode=OneWay}">
                <Image.RenderTransform>
                    <RotateTransform Angle="{x:Bind ViewModel.RotationAngle, Mode=OneWay}" />
                </Image.RenderTransform>
            </Image>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="打开一张图片开始"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" />
        </Grid>

        <!-- 完整文件名：前缀 + 高亮标签段 + 后缀（等宽字体；Inlines 由 code-behind 组装） -->
        <Border
            Grid.Row="1"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                x:Name="FileNameText"
                FontFamily="Cascadia Mono,Consolas"
                FontSize="13"
                IsTextSelectionEnabled="True"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.FileNameVisibility, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
