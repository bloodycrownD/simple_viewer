<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleViewer.Views.TagEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:SimpleViewer.Views"
    MinWidth="420">
    <!-- 职责：标签/组编辑对话框内容控件（spec Step 9，D13：沿用 SettingsPage 的 ContentDialog + TrySave 模板）——
              新建组/标签、重命名（显示影响张数）、删除（先告知范围）、互斥⇄多选切换确认。
              按操作种类（TagEditKind）显隐输入区；执行委托（MainViewModel.ExecuteTagEditAsync）返回错误
              时显示于本对话框且不关闭；宿主 ContentDialog 的 PrimaryButtonClick 经 deferral 异步等待 TrySaveAsync。 -->

    <StackPanel Spacing="12">
        <!-- 说明文本（影响张数/操作范围提示；13px 次要色，行距宽松，对齐 demo .modal-msg） -->
        <TextBlock
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            LineHeight="22"
            Text="{x:Bind Description, Mode=OneWay}"
            TextWrapping="Wrap" />

        <!-- 名称输入（新建/重命名） -->
        <StackPanel Spacing="4" Visibility="{x:Bind views:TagEditDialog.VisibilityOf(ShowNameInput), Mode=OneWay}">
            <TextBlock FontSize="12" Text="{x:Bind NameLabel, Mode=OneWay}" />
            <TextBox
                x:Name="NameInput"
                PlaceholderText="不能含空格或方括号（TagSpaces 文件名语法约束）" />
        </StackPanel>

        <!-- 互斥复选（仅新建组） -->
        <CheckBox
            x:Name="ExclusiveInput"
            Content="互斥组（组内标签单选，打标时替换同组旧标签；适合星级/状态类）"
            IsChecked="False"
            Visibility="{x:Bind views:TagEditDialog.VisibilityOf(ShowExclusiveInput), Mode=OneWay}" />

        <!-- 错误反馈（校验/执行失败：显示且不关闭对话框；code-behind 直接驱动，无需绑定通知） -->
        <TextBlock
            x:Name="ErrorTextBlock"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
