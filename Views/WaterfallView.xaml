<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleViewer.Views.WaterfallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：瀑布流图库视图（spec Step 8）——ItemsRepeater + MasonryLayout、卡片模板（缩略图占位→异步渐入、
              标签角标、选中态边框、文件名剥离标签段）、resize 去抖重排、空态文本。
              缩略图按需加载：ElementPrepared/ElementClearing 事件在 code-behind 接线（禁止一次性全量加载）。
              Esc 从单图返回后滚动位置由互斥 Visibility 切换天然保持（Collapsed 不卸载元素树，无需代码）。
              卡片文字区高度 48 与 MasonryLayout.TextAreaHeight 对齐（D3 常量化估算值，两处同步调整）。 -->

    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="OnScrollerSizeChanged"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <ItemsRepeater x:Name="Repeater">
                <ItemsRepeater.Layout>
                    <views:MasonryLayout x:Name="Masonry" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:GalleryItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{x:Bind views:WaterfallConverters.CardBorderBrush(IsSelected), Mode=OneWay}"
                            BorderThickness="2"
                            CornerRadius="8"
                            DoubleTapped="{x:Bind OpenInViewer}"
                            Tag="{x:Bind}"
                            Tapped="OnCardTapped">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>

                                <!-- 缩略图占位（浅色块）→ 异步渐入：OpacityTransition 驱动 0→1 过渡 -->
                                <Grid
                                    Grid.Row="0"
                                    Background="{ThemeResource LayerFillColorSecondaryBrush}"
                                    Opacity="{x:Bind views:WaterfallConverters.PresenceOpacity(Thumbnail), Mode=OneWay}">
                                    <Grid.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.25" />
                                    </Grid.OpacityTransition>
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />

                                    <!-- 选中角标（左上；Step 8 单击选中，Ctrl/Shift 连选属 Step 10） -->
                                    <Border
                                        Width="20"
                                        Height="20"
                                        Margin="6"
                                        Padding="0,1,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{x:Bind views:WaterfallConverters.CardBorderBrush(IsSelected), Mode=OneWay}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind views:WaterfallConverters.SelectedToVisibility(IsSelected), Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="&#x2713;" />
                                    </Border>
                                </Grid>

                                <!-- 文字区：文件名（剥离标签段）+ 标签角标（前 3 个 + "+N"，统一强调色） -->
                                <StackPanel
                                    Grid.Row="1"
                                    Height="48"
                                    Padding="8,4"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="12"
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind FullFileName, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind BadgeLine, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind views:WaterfallConverters.NonEmptyTextToVisibility(BadgeLine), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 瀑布流空态：图库已打开、非扫描中且无项/筛选无命中时显示（首次启动引导在 MainWindow 覆盖层） -->
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.WaterfallEmptyText, Mode=OneWay}"
            TextAlignment="Center"
            Visibility="{x:Bind ViewModel.WaterfallEmptyVisibility, Mode=OneWay}" />
    </Grid>
</UserControl>
