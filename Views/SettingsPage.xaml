<UserControl
    x:Class="SimpleViewer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    Width="560"
    MinHeight="420"
    PreviewKeyDown="OnPreviewKeyDown">

    <Grid Padding="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            FontSize="14"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Configure keyboard shortcuts. Conflicting key bindings are rejected on save."
            TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="ShortcutsList"
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutEditorItem">
                        <Grid Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                Text="{x:Bind DisplayKey}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Text="{x:Bind Command}" />
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TargetPath}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Edit selected" />

                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Key" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.SelectedDisplayKey, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.StartRecordKeyCommand}"
                        Content="Record key" />
                </StackPanel>

                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Command" />
                <ComboBox
                    x:Name="CommandCombo"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.AvailableCommandNames, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCommandName, Mode=TwoWay}"
                    SelectionChanged="OnCommandSelectionChanged" />

                <StackPanel
                    x:Name="MoveFolderPanel"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.IsMoveToFolderSelected, Mode=OneWay}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Target folder" />
                    <TextBox
                        PlaceholderText="Folder path"
                        Text="{x:Bind ViewModel.SelectedTargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Click="OnPickFolderClick" Content="Browse…" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button Command="{x:Bind ViewModel.AddCommand}" Content="Add" />
            <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="Delete" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnSaveClick" Content="Save" />
            <Button Click="OnCancelClick" Content="Cancel" />
        </StackPanel>
    </Grid>
</UserControl>
