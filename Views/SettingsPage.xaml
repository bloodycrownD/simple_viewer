<UserControl
    x:Class="SimpleViewer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    MinWidth="640"
    MinHeight="400"
    PreviewKeyDown="OnPreviewKeyDown">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Disabled">
        <Grid Padding="4,0,4,4" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="配置键盘快捷键。保存时将拒绝相互冲突的按键组合。"
                TextWrapping="Wrap" />

            <StackPanel Grid.Row="1" Spacing="4">
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="按键" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="命令" />
                </Grid>

                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MaxHeight="220">
                    <ListView
                        x:Name="ShortcutsList"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShortcutEditorItem">
                                <Grid Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayKey}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind CommandDisplayText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <Border
                Grid.Row="2"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="编辑所选快捷键" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="按键" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                MinWidth="80"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.SelectedDisplayKey, Mode=OneWay}" />
                            <Button
                                Command="{x:Bind ViewModel.StartRecordKeyCommand}"
                                Content="录制按键" />
                        </StackPanel>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="命令" />
                        <ComboBox
                            x:Name="CommandCombo"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="200"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind ViewModel.CommandOptions, Mode=OneWay}"
                            SelectedValue="{x:Bind ViewModel.SelectedCommandName, Mode=TwoWay}"
                            SelectedValuePath="Value" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="文件夹"
                            Visibility="{x:Bind ViewModel.IsMoveToFolderSelected, Mode=OneWay}" />
                        <StackPanel
                            x:Name="MoveFolderPanel"
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsMoveToFolderSelected, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    PlaceholderText="文件夹路径"
                                    Text="{x:Bind ViewModel.SelectedTargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    Click="OnPickFolderClick"
                                    Content="浏览…" />
                            </Grid>
                        </StackPanel>

                        <!-- ApplyTag 参数编辑（Step 12）：标签下拉（设置 TagGroups 展平，值 = 标签稳定 Id）。 -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="标签"
                            Visibility="{x:Bind ViewModel.IsApplyTagSelected, Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="1"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.IsApplyTagSelected, Mode=OneWay}">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                MinWidth="200"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.TagOptions, Mode=OneWay}"
                                PlaceholderText="选择标签"
                                SelectedValue="{x:Bind ViewModel.SelectedTagId, Mode=TwoWay}"
                                SelectedValuePath="TagId" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="尚未配置任何标签，请先在主窗口标签栏新建标签。"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.NoTagOptionsHint, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.AddCommand}" Content="添加" />
                <Button Command="{x:Bind ViewModel.DeleteCommand}" Content="删除" />
            </StackPanel>

            <TextBlock
                Grid.Row="4"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</UserControl>
