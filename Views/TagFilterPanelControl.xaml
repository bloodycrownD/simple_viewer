<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimpleViewer.Views.TagFilterPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="660"
    MaxHeight="520">
    <!-- 职责：筛选面板内容控件（tag-filter-tree Step 5，宿主 = 工具栏「⧩ 筛选」按钮的 Button.Flyout）——
              头（标题 / 「条件实时生效」提示 / ✕ 关闭）+ 条件树滚动区（code-behind 递归构造：
              组 = 卡片全层统一含最外层根组、卡片嵌套卡片、嵌套层底色交替 + 左侧 accent 竖线；
              组头「满足以下 [全部/任一] 条件」切换 + 非根组 ✕；条件行 [包含任一/不包含任一] +
              已选标签 chips（✕ 移除值）+「＋ 标签」+ 行尾 ✕；组底「＋ 条件」「＋ 条件组」——
              深度 < MaxDepth 才显示组按钮）+ 底（表达式预览 + 命中数 + 清空条件 + 完成）。
              交互语义基准 demo\filter.html（.flyout/.f-group-box/.f-row/.popover 同构）。
              主题策略：面板根 RequestedTheme 由宿主在 Flyout.Opening 对齐 RootGrid（popup 层不认
              运行时覆盖，ApplyDialogTheme 同款坑位），本 XAML 骨架字色/描边用既有 ThemeResource
              （随面板根 RequestedTheme 正确解析）；不透明实底（面板底 / 预览区底）与树内 code-behind
              构造颜色一律 TagSidebarConverters 的 IsDarkTheme 双值（ApplyThemeColors 统一施加，
              每次打开/编辑重建时随最新主题标志重算）。
              交互不变量：条件实时生效——每次编辑即走 MainViewModel.EditFilter 集中管线
              （树编辑 → 互斥清 untagged → ApplyTagFilter，无应用按钮）；全量 Rebuild 不可变快照
              （demo renderPanel 同构，滚动偏移保持）；图标一律 BMP 文本字符（⧩✕✓＋－▾），
              不用 FontIcon/SymbolIcon；交互用 Click 不用 Tapped；组连接词/匹配词为两态切换按钮组
              （非 ComboBox——Flyout 内二级下拉属 popup 层主题失控风险，spec R1 同类规避，见 .cs 头注释）。 -->

    <Grid x:Name="PanelRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头（demo .flyout-head） -->
        <Grid Grid.Row="0" Padding="14,12,10,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="⧩ 筛选" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="条件实时生效" />
            <Button
                Grid.Column="2"
                Click="OnCloseClicked"
                Content="✕"
                Style="{StaticResource GhostIconButtonStyle}"
                ToolTipService.ToolTip="关闭" />
        </Grid>

        <!-- 条件树渲染区（code-behind 递归构造组卡片填充 TreeHost；demo .flyout-body） -->
        <ScrollViewer
            x:Name="TreeScroll"
            Grid.Row="1"
            Padding="12,0,10,12"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ZoomMode="Disabled">
            <StackPanel x:Name="TreeHost" Spacing="6" />
        </ScrollViewer>

        <!-- 底（demo .flyout-foot：表达式预览 + 命中数 + 清空条件 + 完成）。
             右侧 Padding 20：给宿主极端矮窗口下可能出现的外层滚动条让位（外层已 Disabled，
             此为双保险——勿把命中数字贴到面板右缘）。 -->
        <StackPanel Grid.Row="2" Spacing="8" Padding="14,10,20,12">
            <!-- 表达式预览（demo .expr-preview：Inlines 由 code-behind 按 BuildExpression 段着色填充——
                 否定红 / 连接词与括号灰、条件主文字色） -->
            <Border
                x:Name="ExprPreviewBorder"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,1,8,0"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="表达式" />
                    <TextBlock
                        x:Name="ExprText"
                        Grid.Column="1"
                        FontSize="12"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 操作行：命中数（复用 MainViewModel.FilterStatsText，实时）+ 清空条件 + 完成
                 （完成 = 默认样式按钮，系统 accent 实底，对齐 demo .primary-btn） -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Main.FilterStatsText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Click="OnClearClicked"
                    Content="清空条件"
                    FontSize="12"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="清空全部条件（重置为空根组）" />
                <Button
                    Grid.Column="2"
                    Click="OnDoneClicked"
                    Content="完成"
                    FontSize="12"
                    ToolTipService.ToolTip="关闭面板（条件保持生效）" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
