<Window
    x:Class="SimpleViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：主窗口壳（D14 双模式；2026-09-19 遮盖式布局重排）——画布层（最底、整窗恒定几何，
         承载单图 SingleImageView）+ chrome 遮盖层（工具栏 / 批量打标进度回执区 D13 InfoBar + ProgressBar /
         左栏 + 图库区）。遮盖语义：收展侧栏/右栏只改变遮盖范围、画布几何不变——
         图片位置不动、也不触发重解码（修“收展图片位移 + 首次闪”两问题；口径见 docs\apm\RULE.md 铁律②）。
         图库区：状态行 / 筛选条（tag-filter-tree：条件树表达式段 chips——条件胶囊（否定红）+ 且/或/括号
         轻量文本、✕ 单删条件、命中统计、清空按钮）/ 瀑布流。
         底部状态栏已整体移除（2026-09-19 用户实测反馈）：单图信息由右栏结构化行承载，
         操作回执统一走 InfoBar（成功静默、失败弹出）。 -->

    <Grid x:Name="RootGrid" PreviewKeyDown="OnPreviewKeyDown">
        <!-- 画布层（最底、整窗）：几何恒定，仅窗口 resize 变化。放大保持画布层置底——
             放大溢出被 chrome/浮层遮盖属预期（2026-09-19 用户拍板置底）。 -->
        <Grid x:Name="CanvasLayer" Canvas.ZIndex="0">
            <ContentControl
                x:Name="SingleImageHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Visibility="{x:Bind ViewModel.SingleVisibility, Mode=OneWay}" />
        </Grid>

        <!-- chrome 遮盖层（恒 ZIndex=1）：本层与其内 MainAreaGrid/ContentAreaGrid 均为无 Background 的
             Grid（不吞指针）——未遮区域指针穿透到画布，单图手势正常（命中测试约束，勿补 Background）。 -->
        <Grid x:Name="ChromeLayer" Canvas.ZIndex="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏（2026-09-19 左对齐重做；batch-tag-management Step 6 左右簇 + 场景显隐 D8）：
             外层 Grid 两列——左簇左对齐（打开/打开图库 常显 + 选择/⧩筛选/删除 仅图库模式）、
             右簇右对齐（返回图库/上一张/下一张/左旋/右旋 仅单图模式 + 设置/主题/全屏 常显收尾）；
             模式组整体嵌套 StackPanel + Visibility 绑派生属性（GalleryOnlyControlsVisibility /
             SingleOnlyControlsVisibility，挂 OnCurrentModeChanged 通知链），隐藏 = Collapsed 非禁用
             （PRD：按钮直接隐藏；快捷键走 OnPreviewKeyDown 与按钮无关，零影响）。
             图标一律 BMP 文本字符（不用 FontIcon/SymbolIcon 的 PUA 字形，RULE）。窄窗口横向可滚
             （内容宽于视口时 Grid 按内容 arrange 参与滚动；宽于内容时 * 列撑开右簇贴右）。 -->
        <Border
            x:Name="ToolBarRow"
            Grid.Row="0"
            Padding="8,4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <ScrollViewer
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左簇：文件入口（常显）+ 图库操作组（仅图库模式） -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Command="{x:Bind ViewModel.OpenFilePickerCommand}"
                            Content="打开"
                            Style="{StaticResource GhostButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.OpenLibraryCommand}"
                            Content="打开图库"
                            Style="{StaticResource GhostButtonStyle}" />
                        <!-- 图库操作组（仅图库模式显示，D8）：全选/筛选/删除随组整体隐藏；
                             组首分隔线同组隐藏（常显按钮与图库组之间的语义分界） -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.GalleryOnlyControlsVisibility, Mode=OneWay}">
                            <Rectangle
                                Width="1"
                                Height="16"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <!-- 「选择」no-op 口径（D8 拍板）：无图库 / 呈现集为空时点击空转——
                                 ToggleSelectAll 未全选分支走 SelectAllCards（空呈现集无事发生）、
                                 已全选分支走 ClearCardSelection（空集亦无事发生），现状行为即
                                 PRD「不响应」，无需额外守卫；快捷键 Ctrl+A 仅图库模式接管（现状口径）。 -->
                            <Button
                                AutomationProperties.AutomationId="SelectAllButton"
                                Command="{x:Bind ViewModel.ToggleSelectAllCommand}"
                                Content="{x:Bind ViewModel.SelectAllToggleText, Mode=OneWay}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="全选 / 取消全选当前呈现集（Ctrl+A 全选，Esc 取消）" />
                            <!-- 筛选按钮（tag-filter-tree Step 5，demo .filter-toggle 同构）：文本字符图标
                                 ⧩ 筛选 ▾（Click 挂 Flyout 自动开关）；有条件时强调态（accent 淡底/字/描边，
                                 ActiveConditionCount 经函数绑定驱动）+ 数字徽章（小圆角计数，demo .cond-badge）。
                                 位置（batch-tag-management Step 6 / D8 重排拍板）：图库操作组（左簇）——
                                 tag-filter-tree 期「挪到工具栏尾部」的五轮走查权衡（flyout 不盖左栏）被本需求
                                 PRD 需求 4 左簇分组覆盖；Placement=Bottom 不变，按钮位置在左簇图库组
                                 （打开/打开图库之后），700 宽面板起点较旧左侧位右移，遮盖左栏上缘的风险
                                 由 Step 9 实机走查复核。面板宿主 Flyout 内容由 code-behind 注入
                                 （构造注入惯例，XAML 占位 ContentControl）。 -->
                            <Button
                                x:Name="FilterToggleButton"
                                Background="{x:Bind views:TagSidebarConverters.FilterToggleBackground(ViewModel.ActiveConditionCount), Mode=OneWay}"
                                BorderBrush="{x:Bind views:TagSidebarConverters.FilterToggleBorderBrush(ViewModel.ActiveConditionCount), Mode=OneWay}"
                                BorderThickness="1"
                                Foreground="{x:Bind views:TagSidebarConverters.FilterToggleForeground(ViewModel.ActiveConditionCount), Mode=OneWay}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTipService.ToolTip="标签筛选（条件实时生效）">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock VerticalAlignment="Center" Text="⧩ 筛选" />
                                    <Border
                                        MinWidth="16"
                                        Height="16"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind views:TagSidebarConverters.FilterToggleBadgeBackground(), Mode=OneWay}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind views:TagSidebarConverters.FilterBadgeVisibility(ViewModel.ActiveConditionCount), Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{x:Bind views:TagSidebarConverters.FilterToggleBadgeForeground(), Mode=OneWay}"
                                            Text="{x:Bind ViewModel.ActiveConditionCount, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Text="▾" />
                                </StackPanel>
                                <Button.Flyout>
                                    <!-- 面板本体 code-behind 构造注入（TagFilterPanelControl(Main, vm) 构造签名，
                                         对齐 TagSidebarHost 惯例）；主题对齐与打开时重建在 Flyout.Opening（.cs）。
                                         FlyoutPresenterStyle（实机走查修复，两轮）：WinUI 默认 FlyoutThemeMaxWidth=456
                                         会把面板硬夹成 456 逻辑宽导致内容竖排挤压——覆盖为 700=660(面板)+左右
                                         FlyoutContentPadding 16×2+边框余量（二轮加宽：底部操作行与条件行留裕）；
                                         BasedOn DefaultFlyoutPresenterStyle（generic.xaml 核实存在）保默认模板。 -->
                                    <Flyout x:Name="TagFilterFlyout" Placement="Bottom">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                                <Setter Property="MinWidth" Value="700" />
                                                <Setter Property="MaxWidth" Value="700" />
                                                <!-- 外层滚动禁用（实机走查二轮修复）：FlyoutPresenter 自带 ScrollViewer
                                                     在面板高于按钮下方可用空间时给出贯穿面板全高的滚动条，压住底部
                                                     「命中 N / 已发现 N 张」的数字；改为面板内部 TreeScroll 自滚
                                                     （UserControl MaxHeight=520 收紧总高），外层不再滚。 -->
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <ContentControl x:Name="FilterPanelHost" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <!-- 删除（图库操作组收尾，batch-tag-management Step 7 / D9 落地）：
                                 图库语义 = 删除选中集（DeleteSelectionCommand，空选中 no-op——PRD D3）。
                                 Delete 快捷键在 DispatchShortcut 按模式分流（Gallery→本命令，
                                 Single→现状删当前图，D4 不变）；单图模式本按钮已随组隐藏，
                                 快捷键全模式可用不受按钮隐藏影响。 -->
                            <Button
                                AutomationProperties.AutomationId="DeleteButton"
                                Command="{x:Bind ViewModel.DeleteSelectionCommand}"
                                Content="删除"
                                Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 右簇：单图操作组（仅单图模式）+ 全局收尾（常显） -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2">
                        <!-- 单图操作组（仅单图模式显示，D8）：返回图库 | 翻页 | 旋转 三段语义分组
                             竖线沿用 2026-09-19 视觉节奏，随组整体隐藏；组尾竖线为与常显收尾组的分界，
                             同组隐藏（图库模式下右簇仅剩 设置/主题/全屏 右对齐） -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.SingleOnlyControlsVisibility, Mode=OneWay}">
                            <Button
                                Command="{x:Bind ViewModel.BackToGalleryCommand}"
                                Content="返回图库"
                                Style="{StaticResource GhostButtonStyle}" />
                            <Rectangle
                                Width="1"
                                Height="16"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button
                                Command="{x:Bind ViewModel.PrevCommand}"
                                Content="上一张"
                                Style="{StaticResource GhostButtonStyle}" />
                            <Button
                                Command="{x:Bind ViewModel.NextCommand}"
                                Content="下一张"
                                Style="{StaticResource GhostButtonStyle}" />
                            <Rectangle
                                Width="1"
                                Height="16"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button
                                Command="{x:Bind ViewModel.RotateLeftCommand}"
                                Content="左旋"
                                Style="{StaticResource GhostButtonStyle}" />
                            <Button
                                Command="{x:Bind ViewModel.RotateRightCommand}"
                                Content="右旋"
                                Style="{StaticResource GhostButtonStyle}" />
                            <Rectangle
                                Width="1"
                                Height="16"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                        </StackPanel>
                        <Button
                            Command="{x:Bind ViewModel.OpenSettingsCommand}"
                            Content="设置"
                            Style="{StaticResource GhostButtonStyle}" />
                        <!-- 主题三态循环（深色默认/浅色/跟随系统），demo 深色优先的观感由此保证；
                             Content 由 ApplyTheme 按 当前态 写（如"主题：深色"）；唯一 Click 处理器，
                             D8 重排只挪位置不动接线 -->
                        <Button
                            x:Name="ThemeButton"
                            Click="OnThemeButtonClick"
                            Content="主题"
                            Style="{StaticResource GhostButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                            Content="全屏"
                            Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid x:Name="MainAreaGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏展开态：标签栏（Step 9 TagSidebarControl，code-behind 宿主注入，随折叠开关显隐）。
                 Width="280" 锚点（cr/P2-9 跨文件常量）：与 SingleImageView.SidebarExpandedWidth 一致
                 （右栏浮层避让按同宽让位），改宽度时两处同步。 -->
            <Border
                Grid.Column="0"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarExpandedVisibility, Mode=OneWay}">
                <!-- 注：WinUI 3 无 DockPanel（布局一律 Grid）；图标用文本字符，
                     且不用 U+00AB/U+00BB 与 FontIcon/SymbolIcon 的 PUA 字形（U+E7xx）——
                     这些码点会使 WinAppSDK 1.6.240923002 的 XamlCompiler 沉默崩溃（退出码 1 无输出），CJK 字符安全 -->
                <ContentControl
                    x:Name="TagSidebarHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>

            <!-- 左栏折叠态：窄条仅保留展开按钮（▶ 指向展开方向；BMP 文本字符）。
                 Width="36" 锚点（cr/P2-9 跨文件常量）：与 SingleImageView.SidebarCollapsedWidth 一致
                 （右栏浮层避让按同宽让位），改宽度时两处同步。 -->
            <Border
                Grid.Column="0"
                Width="36"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarCollapsedVisibility, Mode=OneWay}">
                <Button
                    Margin="0,8,0,0"
                    Padding="6,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    Content="▶"
                    FontSize="13"
                    Style="{StaticResource GhostIconButtonStyle}"
                    ToolTipService.ToolTip="展开标签栏" />
            </Border>

            <!-- 内容区（遮盖式布局后仅承载图库视图；单图已移至画布层 CanvasLayer）。
                 放大置底（2026-09-19 用户拍板）：画布层恒置底，放大图片溢出被
                 左栏/工具栏等 chrome 遮盖属预期，不再整体提层。 -->
            <Grid x:Name="ContentAreaGrid" Grid.Column="1">
                <Grid Visibility="{x:Bind ViewModel.GalleryVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 图库状态行：扫描进度/共 N 张/已选 N 张（筛选命中数在筛选条显示）。
                         「清除选择」按钮已移除（2026-09-19 用户权衡：Esc/点击空白即清空，
                         常显禁用按钮属冗余视觉噪音；对照 29e3949 引入侧回退）。 -->
                    <Border
                        Grid.Row="0"
                        Padding="16,6"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.GalleryStatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Border>

                    <!-- 筛选条（tag-filter-tree，视觉对齐 demo #filterBar）：强调色 12% 透明底一行；
                         chips = 条件树人话表达式段（demo exprChips 同构）——条件段胶囊（强调色描边 +
                         淡底 + ✕ 删节点；NotIn 否定段红前景 + 「非」前缀文本）、且/或/括号段轻量灰文本；
                         右侧命中统计 + 清空按钮（demo 形态）；任一筛选激活时显示 -->
                    <Border
                        Grid.Row="1"
                        Padding="16,8"
                        Background="{x:Bind views:TagSidebarConverters.FilterBarBackground()}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：表达式段 chips 列表（横向滚动） -->
                            <ScrollViewer
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="6" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChipViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 条件/无标签段：胶囊 + ✕ 单删 -->
                                                <Border
                                                    Padding="10,2"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind views:TagSidebarConverters.FilterChipBackground(Kind, Negated)}"
                                                    BorderBrush="{x:Bind views:TagSidebarConverters.FilterChipBorderBrush(Kind, Negated)}"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Visibility="{x:Bind views:TagSidebarConverters.FilterChipCapsuleVisibility(Kind)}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{x:Bind views:TagSidebarConverters.FilterChipForeground(Kind, Negated)}"
                                                            Text="{x:Bind Text}" />
                                                        <Button
                                                            Padding="3,0"
                                                            Command="{x:Bind RemoveCommand}"
                                                            Content="✕"
                                                            FontSize="12"
                                                            Foreground="{x:Bind views:TagSidebarConverters.FilterChipForeground(Kind, Negated)}"
                                                            Style="{StaticResource GhostIconButtonStyle}"
                                                            ToolTipService.ToolTip="移除该条件" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 连接词/括号段：轻量文本（无胶囊） -->
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind views:TagSidebarConverters.FilterChipForeground(Kind, Negated)}"
                                                    Text="{x:Bind Text}"
                                                    Visibility="{x:Bind views:TagSidebarConverters.FilterChipSegmentVisibility(Kind)}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <!-- 右侧：命中统计 + 清空（demo .filter-right 形态——tag-filter-tree 恢复清空入口：
                                 表达式复杂后逐条删除不现实，推翻 untagged-filter-entry 期“移除清空按钮”旧拍板） -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.FilterStatsText, Mode=OneWay}" />
                                <Button
                                    Command="{x:Bind ViewModel.ClearTagFilterCommand}"
                                    Content="清空"
                                    FontSize="12"
                                    Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 瀑布流 + 图库右栏（batch-tag-management Step 4 / 拍板 D5；2026-09-23 用户走查修订：
                         右栏为布局列与画布同级——像左栏一样占布局槽，收展改变瀑布流可用宽度、经窗口
                         resize 同一路径触发重排；遮盖式布局铁律仅约束单图画布（遮盖不改画布几何防重
                         解码），瀑布流本就响应宽度重排，浮层遮盖会藏住缩略图（用户走查打回）。
                         随 GalleryVisibility 单图模式天然隐藏；位于工具栏行之下无需 TopChromeHeight
                         避让。右栏由 code-behind 构造注入（带 MainViewModel，WaterfallHost 先例），
                         Auto 列宽随其内 280/36 双 Border 切换。 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 瀑布流本体（code-behind 构造注入，沿用 SingleImageHost 宿主惯例） -->
                        <ContentControl
                            x:Name="WaterfallHost"
                            Grid.Column="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

                        <!-- 图库右栏（选中集标签面板）宿主 -->
                        <ContentControl x:Name="GallerySelectionPanelHost" Grid.Column="1" />
                    </Grid>

                    <!-- 首次启动空态引导（未打开图库且未在扫描） -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.GalleryHintVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                            TextAlignment="Center"
                            Visibility="{x:Bind ViewModel.ScanStatusVisibility, Mode=OneWay}" />
                        <TextBlock
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="点击工具栏「打开图库」选择图片根目录开始"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 批量打标进度/回执区（D13：主窗口内嵌 InfoBar，非 ContentDialog）：
             批量进行中显示 ProgressBar 分批推进；成功一律静默不弹（2026-09-19 拍板——就地反馈已充分，
             仅失败/警告弹终态回执，失败明细可滚动展开）；用户关闭经 TwoWay 写回 VM（下次操作重新打开）。
             位置注意（XamlCompiler bug 规避）：本块须位于 MainAreaGrid 之后——状态栏移除后若 MainAreaGrid
             成为 ChromeLayer 最后一个子元素，WinAppSDK 1.6.240923002 的 XamlCompiler Pass1 会沉默崩溃
             （退出码 1 无输出，MSB3073）；Grid 布局按 Grid.Row 定位，子元素顺序不影响布局，仅 z 序叠加
             （InfoBar 在 Row1、MainAreaGrid 在 Row2，互不重叠，无视觉差异）。 -->
        <!-- Margin="12,4" 锚点（cr/P2-9 跨文件常量）：竖向分量 4+4 = MainWindow.InfoBarVerticalMargin
             （OnChromeRowSizeChanged 汇总 chrome 高度时手补）——改竖向 Margin 时两处同步。 -->
        <InfoBar
            x:Name="MainInfoBar"
            Grid.Row="1"
            Margin="12,4"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsTagFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.TagFeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.TagFeedbackSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.TagFeedbackTitle, Mode=OneWay}">
            <StackPanel Spacing="4">
                <ProgressBar
                    Height="4"
                    Maximum="1"
                    Value="{x:Bind ViewModel.TagOperationProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TagOperationProgressVisibility, Mode=OneWay}" />
                <ScrollViewer
                    MaxHeight="96"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.TagFeedbackDetailsVisibility, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TagFeedbackDetails, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </InfoBar>
        </Grid>
    </Grid>
</Window>
