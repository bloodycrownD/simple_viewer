<Window
    x:Class="SimpleViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 职责：主窗口壳（D14 双模式）——工具栏 / Row1 双栏（左栏可折叠 + 内容区互斥视图）/ 状态栏。
         内容区：SingleImageView（ContentControl 宿主，Visibility 由 VM 切换）与图库区占位（扫描状态 + 空态引导）互斥。 -->

    <Grid x:Name="RootGrid" PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                Command="{x:Bind ViewModel.OpenFilePickerCommand}"
                Icon="OpenFile"
                Label="打开" />
            <AppBarButton
                Command="{x:Bind ViewModel.OpenLibraryCommand}"
                Icon="Folder"
                Label="打开图库" />
            <AppBarButton
                Command="{x:Bind ViewModel.BackToGalleryCommand}"
                Icon="Back"
                Label="返回图库" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.PrevCommand}"
                Icon="Back"
                Label="上一张" />
            <AppBarButton
                Command="{x:Bind ViewModel.NextCommand}"
                Icon="Forward"
                Label="下一张" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.RotateLeftCommand}"
                Icon="Rotate"
                Label="左旋" />
            <AppBarButton
                Command="{x:Bind ViewModel.RotateRightCommand}"
                Icon="Rotate"
                Label="右旋" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.DeleteCommand}"
                Icon="Delete"
                Label="删除" />
            <AppBarButton
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Icon="Setting"
                Label="设置" />
            <AppBarButton
                Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                Icon="View"
                Label="全屏" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏展开态：Step 9 放入 TagSidebarControl，本步为壳与折叠开关 -->
            <Border
                Grid.Column="0"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarExpandedVisibility, Mode=OneWay}">
                <!-- 注：WinUI 3 无 DockPanel（用两行 Grid 实现顶栏+剩余区）；图标用文本字符，
                     且不用 «»(U+00AB/BB) 与 FontIcon/SymbolIcon 的 PUA 字形（U+E7xx）——
                     这些码点会使 WinAppSDK 1.6.240923002 的 XamlCompiler 沉默崩溃（退出码 1 无输出），CJK 字符安全 -->
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="标签" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                            Content="收起"
                            FontSize="12"
                            ToolTipService.ToolTip="收起标签栏" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="打开图库后，这里将显示标签列表"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 左栏折叠态：窄条仅保留展开按钮 -->
            <Border
                Grid.Column="0"
                Width="36"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarCollapsedVisibility, Mode=OneWay}">
                <Button
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    Content="展开"
                    FontSize="12"
                    ToolTipService.ToolTip="展开标签栏" />
            </Border>

            <!-- 内容区：单图视图与瀑布流图库互斥（VM Visibility 计算属性，D14） -->
            <Grid Grid.Column="1">
                <ContentControl
                    x:Name="SingleImageHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.SingleVisibility, Mode=OneWay}" />

                <Grid Visibility="{x:Bind ViewModel.GalleryVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 图库状态行：扫描进度/共 N 张/已选 N 张（最小可见反馈） -->
                    <Border
                        Grid.Row="0"
                        Padding="12,6"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.GalleryStatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Border>

                    <!-- 瀑布流本体（code-behind 构造注入，沿用 SingleImageHost 宿主惯例） -->
                    <ContentControl
                        x:Name="WaterfallHost"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

                    <!-- 首次启动空态引导（未打开图库且未在扫描） -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.GalleryHintVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                            TextAlignment="Center"
                            Visibility="{x:Bind ViewModel.ScanStatusVisibility, Mode=OneWay}" />
                        <TextBlock
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="点击工具栏「打开图库」选择图片根目录开始"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
