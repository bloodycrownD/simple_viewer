<Window
    x:Class="SimpleViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SimpleViewer.ViewModels"
    xmlns:views="using:SimpleViewer.Views">
    <!-- 职责：主窗口壳（D14 双模式）——工具栏 / 批量打标进度回执区（D13 InfoBar + ProgressBar）/
         Row2 双栏（左栏可折叠 + 内容区互斥视图）/ 状态栏。
         内容区：SingleImageView（ContentControl 宿主，Visibility 由 VM 切换）与图库区占位（扫描状态 + 空态引导）互斥。
         图库区：状态行 / 筛选条（Step 11：激活标签 chip 单删、OR 徽章、命中统计、一键清空）/ 瀑布流。 -->

    <Grid x:Name="RootGrid" PreviewKeyDown="OnPreviewKeyDown" SizeChanged="OnRootGridSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            Grid.Row="0"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton
                Command="{x:Bind ViewModel.OpenFilePickerCommand}"
                Icon="OpenFile"
                Label="打开" />
            <AppBarButton
                Command="{x:Bind ViewModel.OpenLibraryCommand}"
                Icon="Folder"
                Label="打开图库" />
            <AppBarButton
                Command="{x:Bind ViewModel.BackToGalleryCommand}"
                Icon="Back"
                Label="返回图库" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.PrevCommand}"
                Icon="Back"
                Label="上一张" />
            <AppBarButton
                Command="{x:Bind ViewModel.NextCommand}"
                Icon="Forward"
                Label="下一张" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.RotateLeftCommand}"
                Icon="Rotate"
                Label="左旋" />
            <AppBarButton
                Command="{x:Bind ViewModel.RotateRightCommand}"
                Icon="Rotate"
                Label="右旋" />
            <AppBarSeparator />
            <AppBarButton
                Command="{x:Bind ViewModel.DeleteCommand}"
                Icon="Delete"
                Label="删除" />
            <AppBarButton
                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                Icon="Setting"
                Label="设置" />
            <!-- 主题三态循环（深色默认/浅色/跟随系统），demo 深色优先的观感由此保证 -->
            <AppBarButton
                x:Name="ThemeButton"
                Click="OnThemeButtonClick"
                Icon="Highlight"
                Label="主题" />
            <AppBarButton
                Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                Icon="View"
                Label="全屏" />
        </CommandBar>

        <!-- 批量打标进度/回执区（D13：主窗口内嵌 InfoBar，非 ContentDialog）：
             进行中显示 ProgressBar 分批推进；终态回执“成功 N / 失败 M”，失败明细可滚动展开；
             用户关闭经 TwoWay 写回 VM（下次操作重新打开） -->
        <InfoBar
            Grid.Row="1"
            Margin="12,4"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsTagFeedbackOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.TagFeedbackMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.TagFeedbackSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.TagFeedbackTitle, Mode=OneWay}">
            <StackPanel Spacing="4">
                <ProgressBar
                    Height="4"
                    Maximum="1"
                    Value="{x:Bind ViewModel.TagOperationProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.TagOperationProgressVisibility, Mode=OneWay}" />
                <ScrollViewer
                    MaxHeight="96"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.TagFeedbackDetailsVisibility, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TagFeedbackDetails, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </InfoBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏展开态：标签栏（Step 9 TagSidebarControl，code-behind 宿主注入，随折叠开关显隐） -->
            <Border
                Grid.Column="0"
                Width="280"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarExpandedVisibility, Mode=OneWay}">
                <!-- 注：WinUI 3 无 DockPanel（布局一律 Grid）；图标用文本字符，
                     且不用 U+00AB/U+00BB 与 FontIcon/SymbolIcon 的 PUA 字形（U+E7xx）——
                     这些码点会使 WinAppSDK 1.6.240923002 的 XamlCompiler 沉默崩溃（退出码 1 无输出），CJK 字符安全 -->
                <ContentControl
                    x:Name="TagSidebarHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>

            <!-- 左栏折叠态：窄条仅保留展开按钮 -->
            <Border
                Grid.Column="0"
                Width="36"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{x:Bind ViewModel.SidebarCollapsedVisibility, Mode=OneWay}">
                <Button
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                    Content="展开"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTipService.ToolTip="展开标签栏" />
            </Border>

            <!-- 内容区：单图视图与瀑布流图库互斥（VM Visibility 计算属性，D14） -->
            <Grid Grid.Column="1">
                <ContentControl
                    x:Name="SingleImageHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.SingleVisibility, Mode=OneWay}" />

                <Grid Visibility="{x:Bind ViewModel.GalleryVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 图库状态行：扫描进度/共 N 张/已选 N 张（筛选命中数在筛选条显示） -->
                    <Border
                        Grid.Row="0"
                        Padding="16,6"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.GalleryStatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Border>

                    <!-- 筛选条（Step 11，视觉对齐 demo #filterBar）：强调色 12% 透明底一行；
                         OR 徽章 = 虚线描边胶囊；筛选 chip = 「组名：标签名」胶囊（组 hue 描边 + 淡底）+ ✕ 单删；
                         右侧命中统计 + 一键清空；任一筛选激活时显示 -->
                    <Border
                        Grid.Row="1"
                        Padding="16,8"
                        Background="{x:Bind views:TagSidebarConverters.FilterBarBackground()}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{x:Bind ViewModel.FilterBarVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：OR 虚线徽章 + chip 列表（横向滚动） -->
                            <ScrollViewer
                                Grid.Column="0"
                                HorizontalScrollBarVisibility="Hidden"
                                HorizontalScrollMode="Auto"
                                VerticalScrollBarVisibility="Disabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- OR 徽章：Border 不支持虚线描边，用 Rectangle StrokeDashArray 实现 -->
                                    <Grid
                                        Padding="10,2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.OrBadgeVisibility, Mode=OneWay}">
                                        <Rectangle
                                            RadiusX="11"
                                            RadiusY="11"
                                            Stretch="Fill"
                                            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                            StrokeDashArray="4 2"
                                            StrokeThickness="1" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="任一命中（OR）" />
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FilterChipViewModel">
                                                <Border
                                                    Padding="10,2"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind views:TagSidebarConverters.FilterChipBackground(GroupName)}"
                                                    BorderBrush="{x:Bind views:TagSidebarConverters.FilterChipBorderBrush(GroupName)}"
                                                    BorderThickness="1"
                                                    CornerRadius="999">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{x:Bind views:TagSidebarConverters.FilterChipForeground(GroupName)}"
                                                            Text="{x:Bind views:TagSidebarConverters.FilterChipText(GroupName, TagName)}" />
                                                        <Button
                                                            Padding="3,0"
                                                            Command="{x:Bind RemoveFilterCommand}"
                                                            Content="✕"
                                                            FontSize="12"
                                                            Foreground="{x:Bind views:TagSidebarConverters.FilterChipForeground(GroupName)}"
                                                            Style="{StaticResource GhostIconButtonStyle}"
                                                            ToolTipService.ToolTip="取消该筛选" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 右侧：命中统计 + 清空筛选（demo .filter-right） -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.FilterStatsText, Mode=OneWay}" />
                                <Button
                                    Command="{x:Bind ViewModel.ClearTagFiltersCommand}"
                                    Content="清空筛选"
                                    Style="{StaticResource GhostButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 瀑布流本体（code-behind 构造注入，沿用 SingleImageHost 宿主惯例） -->
                    <ContentControl
                        x:Name="WaterfallHost"
                        Grid.Row="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

                    <!-- 首次启动空态引导（未打开图库且未在扫描） -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.GalleryHintVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                            TextAlignment="Center"
                            Visibility="{x:Bind ViewModel.ScanStatusVisibility, Mode=OneWay}" />
                        <TextBlock
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="点击工具栏「打开图库」选择图片根目录开始"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏（demo #statusBar）：12px 次要色 + 上边线分隔 -->
        <Border
            Grid.Row="3"
            Padding="16,7"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
