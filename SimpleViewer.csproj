<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SimpleViewer</RootNamespace>
    <AssemblyName>viewer</AssemblyName>
    <ApplicationTitle>Simple Viewer</ApplicationTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultPlatform>x64</DefaultPlatform>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <GenerateProjectPriFile>false</GenerateProjectPriFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Helpers\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Include="Helpers\ConsoleHelper.cs" />
    <Compile Include="Helpers\ImageSourceHelper.cs" />
    <Compile Include="Helpers\ImageSourceRetirement.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- The 2.5.1 metapackage also drags in the AI/ML/Search/Widgets sub-packages, which put
         ONNX Runtime + DirectML (~42 MB, unused by this app) into the publish output. Reference
         the sub-packages this app actually needs instead; versions are pinned to the exact set
         the 2.5.1 metapackage resolved to, so the framework assemblies stay bit-identical. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SimpleViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToPublishDirectory锛歱ublish 甯冨眬榛樿涓嶆嫹 Content 椤癸紙瑙ｅ帇鍖呯己鍥炬爣锛?026-09-19锛?-->
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
